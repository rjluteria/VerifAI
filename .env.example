NVIDIA_API_KEY=
TAVILY_API_KEY=
ALLOW_KEYLESS_SEARCH=0
SESSION_SECRET=
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
PORT=8000
MAX_SOURCE_CHECKS=60
SEMANTIC_RETRIEVAL=1

# Opt-in owned-job causal metrics; no content, URLs or credentials. Default Off.
ENABLE_CAUSAL_DIAGNOSTICS=0


# Overlap first independent discovery with citation fetching (bounded workers).
PARALLEL_RETRIEVAL=1
